{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/relay.js": {
      "maxDuration": 30
    },
    "api/prices.js": {
      "maxDuration": 25
    }
  },
  "routes": [
    {
      "src": "/sw\\.js",
      "headers": {
        "Cache-Control": "no-store",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/manifest\\.webmanifest",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Type": "application/manifest+json"
      },
      "continue": true
    },
    {
      "src": "/api/prices",
      "dest": "/api/prices"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/relay?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
