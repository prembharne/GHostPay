{
  "name": "ghostpay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts",
    "frontend",
    "server"
  ],
  "scripts": {
    "compile": "npm run compile -w contracts",
    "test": "npm run test -w contracts && npm run test -w server",
    "test:messenger": "node --import tsx --test frontend/test/*.test.ts",
    "sync:vercel": "npm run build:services && node scripts/sync-vercel.mjs",
    "deploy": "npm run deploy -w contracts",
    "dev": "concurrently -n relay,web -c green,magenta \"npm run dev -w server\" \"npm run dev -w frontend\"",
    "build": "npm run compile && npm run build:services && npm run build -w server && npm run build -w frontend",
    "start": "node scripts/start.mjs",
    "check:sepolia": "node scripts/check-sepolia.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "build:services": "node scripts/build-prices.mjs && node scripts/build-native-artifact.mjs",
    "test:matrix": "node --test infra/matrix/test.mjs",
    "check:matrix": "node infra/matrix/check.mjs",
    "security:community": "node scripts/review-community.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "viem@2.23.2": {
      "ws": "8.21.0",
      "isows": {
        "ws": "8.21.0"
      }
    }
  }
}
