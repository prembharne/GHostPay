# Copy to .env at the project root. Public RPC works without an API key.
# Never use a local-node URL or mainnet endpoint here.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional frontend-only override in frontend/.env.local (browser-visible; no secret RPC keys):
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The wallet setup screen saves deployments/sepolia.json after verifying a real transaction.
# No signing key is required by the app or relay.
# Experienced CLI users may set SEPOLIA_PRIVATE_KEY only in the deployment shell;
# never prefix it with VITE_, commit it, or send it in chat.
# Messaging uses a separate Matrix homeserver. Optional public setting in frontend/.env.local:
# VITE_MATRIX_HOMESERVER=https://matrix.your-domain.com
# Google OAuth client secrets belong only in the Matrix server configuration, never VITE_ settings.

# Optional public override in frontend/.env.local. The supplied project ID is the default.
# VITE_REOWN_PROJECT_ID=your_public_reown_project_id
# Allow https://ghostpay-lac.vercel.app in the Reown Dashboard project settings.
