{
  "id": "/",
  "name": "GhostPay — conversations & payments",
  "short_name": "GhostPay",
  "description": "Your conversations. Your wallet. Native testnet payments, with a little more control.",
  "lang": "en",
  "start_url": "/chat",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#080809",
