  "orientation": "any",
  "categories": ["social", "finance"],
  "icons": [
    {"src": "/icons/ghostpay-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icons/ghostpay-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Messages", "url": "/chat", "icons": [{"src": "/icons/ghostpay-192.png", "sizes": "192x192"}]},
    {"name": "Create payment", "url": "/create", "icons": [{"src": "/icons/ghostpay-192.png", "sizes": "192x192"}]}
  ]
}
